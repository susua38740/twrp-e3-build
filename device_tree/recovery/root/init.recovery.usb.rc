# Meizu E3 / M1851Q (sdm660, kernel 4.19) - TWRP recovery USB
# 4.19 内核只有 configfs，没有 /sys/class/android_usb/android0，
# 故整体替换 TWRP 自带的老 android_usb 写法，否则 adb / MTP 都无法工作。
on init
    setprop sys.usb.configfs 1
    setprop sys.usb.controller a800000.dwc3
    setprop sys.usb.config adb,mtp

on fs
    mkdir /dev/usb-ffs 0770 shell shell
    mkdir /dev/usb-ffs/adb 0770 shell shell
    mount functionfs adb /dev/usb-ffs/adb uid=2000,gid=2000
    mkdir /dev/usb-ffs/mtp 0770 shell shell
    mount functionfs mtp /dev/usb-ffs/mtp rmode=0770,fmode=0660,uid=1023,gid=1023

on fs
    mkdir /config/usb_gadget/g1 0770 shell shell
    write /config/usb_gadget/g1/idVendor  0x2A45
    write /config/usb_gadget/g1/idProduct 0x0C02
    write /config/usb_gadget/g1/bcdDevice 0x0100
    write /config/usb_gadget/g1/bcdUSB    0x0200
    mkdir /config/usb_gadget/g1/strings/0x409 0770
    write /config/usb_gadget/g1/strings/0x409/serialnumber E3TWRP0001
    write /config/usb_gadget/g1/strings/0x409/manufacturer Meizu
    write /config/usb_gadget/g1/strings/0x409/product    M1851Q
    mkdir /config/usb_gadget/g1/functions/ffs.adb
    mkdir /config/usb_gadget/g1/functions/ffs.mtp
    mkdir /config/usb_gadget/g1/configs/b.1 0770
    mkdir /config/usb_gadget/g1/configs/b.1/strings/0x409 0770
    write /config/usb_gadget/g1/configs/b.1/strings/0x409/configuration adb,mtp
    write /config/usb_gadget/g1/configs/b.1/MaxPower 500
    symlink /config/usb_gadget/g1/functions/ffs.adb /config/usb_gadget/g1/configs/b.1/ffs.adb
    symlink /config/usb_gadget/g1/functions/ffs.mtp /config/usb_gadget/g1/configs/b.1/ffs.mtp
    write /config/usb_gadget/g1/UDC a800000.dwc3
    setprop sys.usb.state adb,mtp
    start adbd
